APP_NAME="BPMN Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma-separated list of proxy IPs (or CIDR ranges) allowed to set
# X-Forwarded-* headers, or "*" to trust the immediate upstream unconditionally.
# The app always sits behind an external HTTPS-terminating proxy, so this
# defaults to "*"; tighten it to the proxy's real address in production if
# you want to restrict who can spoof these headers.
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bpmn
DB_USERNAME=bpmn
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# bpmn-js version vendored into the build (no CDN at runtime)
BPMN_JS_VERSION=18.30.0

# Administrator seeded on first deploy (avoids the "chicken and egg" problem)
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Keycloak SSO integration (optional/deferred — ticket 08)
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=
KEYCLOAK_ADMIN_ROLE=bpmn-admin
