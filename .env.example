APP_NAME="BPMN Canvas"
# Production: also load .env.prod (see docker-compose.prod.yml), which sets
# APP_ENV=production, APP_DEBUG=false and stderr logging.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma-separated list of proxy IPs (or CIDR ranges) allowed to set
# X-Forwarded-* headers, or "*" to trust the immediate upstream unconditionally.
# The app always sits behind an external HTTPS-terminating proxy, so this
# defaults to "*"; tighten it to the proxy's real address in production if
# you want to restrict who can spoof these headers.
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bpmn
DB_USERNAME=bpmn
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Development logs outgoing mail; set a real mailer (for example smtp) in production.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Where Diagram Version history is kept (ADR-0004, ADR-0018):
#   git      - one Git repository per Diagram (default; production)
#   database - rows in the diagram_versions table, no subprocesses (browser demo)
VERSION_STORE=git

# Server-side PNG/SVG/PDF export (headless bpmn-js in Chromium, issue #250).
# The Docker image ships Node and Chromium; set these only for a host install.
# RENDERER_NODE_BINARY=node
# RENDERER_CHROMIUM_PATH=/usr/bin/chromium
# RENDERER_TIMEOUT_SECONDS=60

# Seconds a save waits for a Diagram's Version history lock before answering 503
# (retryable). Default 30.
# VERSION_LOCK_WAIT_SECONDS=30

# Host port the `web` container publishes (change if 80 is already taken)
APP_PORT=80

# Administrator seeded on first deploy (avoids the "chicken and egg" problem)
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Automated backup (Diagrams + database) — see the `scheduler` compose
# service, which runs `backup:run` on a schedule (no host cron). The
# default destination is a host directory mounted as a volume
# (./backups, see docker-compose.yml).
BACKUP_DESTINATION=/var/www/html/storage/app/backup
BACKUP_RETENTION_DAYS=14

# Optional off-site copy of every artifact on an S3-compatible bucket, with
# its own retention (ADR-0026). `backup:verify` (daily, after `backup:run`)
# restores the latest artifact into a throwaway database and directory; the
# database role needs CREATE DATABASE for that.
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_RETENTION_DAYS=60
BACKUP_OFFSITE_KEY=
BACKUP_OFFSITE_SECRET=
BACKUP_OFFSITE_REGION=us-east-1
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_PATH_STYLE=false

# Keycloak SSO integration (optional/deferred — ticket 08)
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=
KEYCLOAK_ADMIN_ROLE=bpmn-admin

# Minutes without a Heartbeat before a Lock expires (the Editor stops sending them after 2 minutes idle).
LOCK_TTL_MINUTES=3

# Days activity log entries are kept before activity:prune removes them (0 = keep forever).
# ACTIVITY_LOG_RETENTION_DAYS=0
