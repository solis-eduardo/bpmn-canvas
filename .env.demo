# Browser demo (ADR-0018): the real app on php-wasm, no services around it.
# Non-secret and committed on purpose; the APP_KEY below protects nothing real.
APP_NAME="BPMN Canvas"
APP_ENV=production
APP_KEY=base64:ZGVtby1rZXktbm90LWEtc2VjcmV0LTMyLWJ5dGVzISE=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/persist/database.sqlite

# No database-backed sessions, cache or queue worker inside the WASM runtime.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

# No SSO.
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=

# No git binary and no Postgres to dump.
VERSION_STORE=database
BACKUPS_ENABLED=false

DEMO_MODE=true
