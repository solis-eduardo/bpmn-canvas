<?xml version="1.0"?>
<ruleset name="bpmn-canvas"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>PHPMD ruleset for bpmn-canvas (standard Laravel-project set).</description>

    <rule ref="rulesets/cleancode.xml">
        <!-- Laravel leans on static facades throughout (Storage, Route, DB, ...); flagging every use is noise. -->
        <exclude name="StaticAccess" />
        <!-- Laravel controllers/services commonly construct value objects and DTOs inline. -->
        <exclude name="BooleanArgumentFlag" />
        <!-- `if ($x = foo())` to test-and-capture in one step is a common,
             deliberate PHP idiom here (see ShareController::present()), not
             an accidental `=`/`==` typo. -->
        <exclude name="IfStatementAssignment" />
    </rule>
    <rule ref="rulesets/codesize.xml">
        <!-- A Laravel resource controller/model naturally accumulates public
             methods (one per route action, or per relation/permission
             helper); splitting them up for this metric alone would fight
             the framework's own conventions rather than fix anything. -->
        <exclude name="TooManyPublicMethods" />
    </rule>
    <rule ref="rulesets/design.xml">
        <!-- AppServiceProvider naturally accumulates service bindings and
             event listeners (service providers and event listeners are shared
             dependencies here); splitting them would fight Laravel's own
             conventions. A threshold of 14 allows the current state. -->
        <rule ref="rulesets/design.xml/CouplingBetweenObjects">
            <properties>
                <property name="threshold" value="14" />
            </properties>
        </rule>
    </rule>
    <rule ref="rulesets/unusedcode.xml" />
</ruleset>
