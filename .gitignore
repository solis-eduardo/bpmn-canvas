# Diagram files live only on the host / volume, not versioned in the repo
diagrams/*
!diagrams/.gitkeep

# Backup artifacts (backup:run's default destination) likewise live only on
# the host / volume, not versioned in the repo
backups/*
!backups/.gitkeep

# Laravel
*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Local SQLite (not used in production, but may show up in dev)
/database/database.sqlite
.scratch/
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
