# Non-secret production overrides, layered over `.env` by docker-compose.prod.yml
# (later files win). Keep secrets (APP_KEY, DB_PASSWORD, ADMIN_PASSWORD,
# KEYCLOAK_CLIENT_SECRET, MAIL_PASSWORD) in `.env`, never here.
APP_ENV=production
APP_DEBUG=false

# Containers log to stderr -> `docker compose logs`, rotated by the json-file driver.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
